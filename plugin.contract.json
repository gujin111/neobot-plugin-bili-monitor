{
  "actions": [],
  "config": {
    "additionalProperties": true,
    "description": "B 站监控助手配置（7 项，覆盖 95% 的使用场景）。",
    "properties": {
      "command_prefix": {
        "default": "/",
        "title": "命令前缀",
        "type": "string"
      },
      "cookie": {
        "description": "可选。填 SESSDATA=...; bili_jct=... 可显著降低风控概率；留空则匿名访问。",
        "placeholder": "SESSDATA=xxx; bili_jct=yyy",
        "single_line": true,
        "title": "B 站登录 Cookie",
        "type": "string",
        "writeOnly": true
      },
      "dynamic_interval_seconds": {
        "default": 120,
        "description": "每个 UP 主每隔这么久检查一次；太小容易触发风控，建议 90~300。",
        "maximum": 3600,
        "minimum": 60,
        "title": "动态轮询间隔（秒）",
        "type": "integer"
      },
      "include_link": {
        "default": true,
        "description": "关掉后提醒里不带「点击进入直播间」那行。",
        "title": "附带原文链接",
        "type": "boolean"
      },
      "live_interval_seconds": {
        "default": 90,
        "description": "检查开播/下播的间隔。填 3 可做到开播 3 秒内推送，但请求量是 90 秒档的 30 倍：建议同时填 Cookie，并把订阅数控制在个位数，否则容易触发风控。",
        "maximum": 1800,
        "minimum": 3,
        "title": "直播轮询间隔（秒）",
        "type": "integer"
      },
      "max_subscriptions": {
        "default": 30,
        "description": "同时监控的 UP 主数量上限。",
        "maximum": 200,
        "minimum": 1,
        "title": "订阅上限",
        "type": "integer"
      },
      "send_mode": {
        "default": "auto",
        "description": "auto=有配图就发图、否则纯文本；text=只发文本；image=文本+原图；card=渲染卡片图。",
        "enum": [
          "auto",
          "text",
          "image",
          "card"
        ],
        "title": "发送模式",
        "type": "string"
      },
      "template_dynamic_article": {
        "default": "",
        "description": "同上；{title} 是专栏标题",
        "single_line": true,
        "title": "文案：发布新专栏",
        "type": "string"
      },
      "template_dynamic_audio": {
        "default": "",
        "description": "同上",
        "single_line": true,
        "title": "文案：发布新音频",
        "type": "string"
      },
      "template_dynamic_new": {
        "default": "",
        "description": "留空用内置文案。可用 {name} {title} {text} {link} {url} {time}",
        "single_line": true,
        "title": "文案：发布新动态",
        "type": "string"
      },
      "template_dynamic_repost": {
        "default": "",
        "description": "同上；另可用 {orig_author} {orig_text} {orig_title}",
        "single_line": true,
        "title": "文案：转发动态",
        "type": "string"
      },
      "template_dynamic_video": {
        "default": "",
        "description": "同上；另可用 {duration} {play_text} {bvid}",
        "single_line": true,
        "title": "文案：投稿新视频",
        "type": "string"
      },
      "template_follower": {
        "default": "",
        "description": "同上；可用 {follower_text} {milestone_text}",
        "single_line": true,
        "title": "文案：粉丝里程碑",
        "type": "string"
      },
      "template_live_off": {
        "default": "",
        "description": "同上；另可用 {duration_text} {peak_text}",
        "single_line": true,
        "title": "文案：下播提醒",
        "type": "string"
      },
      "template_live_on": {
        "default": "",
        "description": "同上；另可用 {area} {online_text} {room_id}",
        "single_line": true,
        "title": "文案：开播提醒",
        "type": "string"
      }
    },
    "title": "BiliMonitorConfig",
    "type": "object"
  },
  "guides": [
    {
      "completion_action": null,
      "demo": {
        "config": {
          "dynamic_interval_seconds": 120,
          "live_interval_seconds": 90
        }
      },
      "id": "first-use",
      "steps": [
        {
          "chapter": "打开配置",
          "example": {
            "dynamic_interval_seconds": 120,
            "live_interval_seconds": 90
          },
          "form": "start",
          "target": "config",
          "text": "在插件管理里选择本插件并打开配置表单。下面演示的是公开默认值，不会修改你的真实配置。"
        },
        {
          "chapter": "填写登录 Cookie（可选）",
          "example": {
            "cookie": "SESSDATA=example; bili_jct=example"
          },
          "form": "edit",
          "target": "config.cookie",
          "text": "填 SESSDATA=...; bili_jct=... 可以显著降低被风控的概率；留空则匿名访问。也可以稍后用 /b站登录 qr 扫码获取。"
        },
        {
          "chapter": "保存配置",
          "example": {
            "dynamic_interval_seconds": 120,
            "live_interval_seconds": 90
          },
          "form": "save",
          "target": "config",
          "text": "保存后插件会重载一次，新的轮询间隔立即生效。"
        },
        {
          "chapter": "添加第一个订阅",
          "command": {
            "context": "在群聊中 @机器人 发送",
            "reply": "已开始监控 …（UID 2）",
            "text": "/b站管理 add 2"
          },
          "target": "config",
          "text": "在群里 @机器人 发送 /b站管理 add <UID>，机器人会把提醒推送到当前群。UID 可以从 space.bilibili.com/123456 里取。"
        },
        {
          "chapter": "查看订阅与状态",
          "command": {
            "context": "在群聊中 @机器人 发送",
            "reply": "当前监控 1 个 UP 主：…",
            "text": "/b站监控 list"
          },
          "target": "config",
          "text": "用 /b站监控 list 看列表，/b站监控 status 看轮询与推送统计。"
        }
      ],
      "title": "从零配置 B 站监控"
    }
  ],
  "plugin": {
    "description": "B 站 UP 主动态 / 开播 / 粉丝里程碑监控（移植自 bili 监控助手 1.7.20）",
    "name": "bili_monitor",
    "version": "1.1.1"
  },
  "resources": [],
  "schema_version": 1
}
